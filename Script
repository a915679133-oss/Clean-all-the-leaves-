-- Lite Utility Script (WalkSpeed, Fly, Noclip) for Delta Executor

local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local Title = Instance.new("TextLabel")
local SpeedBtn = Instance.new("TextButton")
local FlyBtn = Instance.new("TextButton")
local NoclipBtn = Instance.new("TextButton")
local CloseBtn = Instance.new("TextButton")

ScreenGui.Name = "LiteUtilsGui"
ScreenGui.Parent = game:GetService("CoreGui")

MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.BorderSizePixel = 0
MainFrame.Position = UDim2.new(0.05, 0, 0.3, 0)
MainFrame.Size = UDim2.new(0, 180, 0, 220)
MainFrame.Active = true
MainFrame.Draggable = true

Title.Parent = MainFrame
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
Title.Text = "⚡ Movement Utilities"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 13

-- 1. SPEED HACK (Переключатель 16 / 100)
local speedOn = false
SpeedBtn.Parent = MainFrame
SpeedBtn.Position = UDim2.new(0.1, 0, 0.18, 0)
SpeedBtn.Size = UDim2.new(0.8, 0, 0, 35)
SpeedBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
SpeedBtn.Text = "Speed: ВЫКЛ"
SpeedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

SpeedBtn.MouseButton1Click:Connect(function()
    speedOn = not speedOn
    if speedOn then
        SpeedBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        SpeedBtn.Text = "Speed: 100"
    else
        SpeedBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        SpeedBtn.Text = "Speed: ВЫКЛ"
        pcall(function() game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 16 end)
    end
end)

task.spawn(function()
    while true do
        if speedOn then
            pcall(function()
                game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 100
            end)
        end
        task.wait(0.1)
    end
end)

-- 2. NOCLIP (Хождение сквозь стены)
local noclipOn = false
NoclipBtn.Parent = MainFrame
NoclipBtn.Position = UDim2.new(0.1, 0, 0.38, 0)
NoclipBtn.Size = UDim2.new(0.8, 0, 0, 35)
NoclipBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
NoclipBtn.Text = "Noclip: ВЫКЛ"
NoclipBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

NoclipBtn.MouseButton1Click:Connect(function()
    noclipOn = not noclipOn
    if noclipOn then
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        NoclipBtn.Text = "Noclip: ВКЛ"
    else
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        NoclipBtn.Text = "Noclip: ВЫКЛ"
    end
end)

game:GetService("RunService").Stepped:Connect(function()
    if noclipOn then
        pcall(function()
            for _, part in ipairs(game.Players.LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
    end
end)

-- 3. FLY (Полёт на BodyVelocity)
local flying = false
local flybv, bg

FlyBtn.Parent = MainFrame
FlyBtn.Position = UDim2.new(0.1, 0, 0.58, 0)
FlyBtn.Size = UDim2.new(0.8, 0, 0, 35)
FlyBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
FlyBtn.Text = "Fly: ВЫКЛ"
FlyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

FlyBtn.MouseButton1Click:Connect(function()
    flying = not flying
    local char = game.Players.LocalPlayer.Character
    if flying and char and char:FindFirstChild("HumanoidRootPart") then
        FlyBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        FlyBtn.Text = "Fly: ВКЛ"
        
        flybv = Instance.new("BodyVelocity")
        flybv.Parent = char.HumanoidRootPart
        flybv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        
        bg = Instance.new("BodyGyro")
        bg.Parent = char.HumanoidRootPart
        bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        bg.P = 9e4
        
        task.spawn(function()
            while flying do
                local cam = workspace.CurrentCamera
                flybv.Velocity = cam.CFrame.LookVector * 50
                bg.CFrame = cam.CFrame
                task.wait()
            end
            if flybv then flybv:Destroy() end
            if bg then bg:Destroy() end
        end)
    else
        FlyBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        FlyBtn.Text = "Fly: ВЫКЛ"
        if flybv then flybv:Destroy() end
        if bg then bg:Destroy() end
    end
end)

-- 4. CLOSE
CloseBtn.Parent = MainFrame
CloseBtn.Position = UDim2.new(0.1, 0, 0.8, 0)
CloseBtn.Size = UDim2.new(0.8, 0, 0, 30)
CloseBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
CloseBtn.Text = "Закрыть"
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

